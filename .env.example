# ==============================================================================
# Forest Fire Prediction & Spread Simulation Platform Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production, testing)
APP_ENV=development
APP_NAME=forest-fire-platform
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=dev-secret-key-forest-fire-simulation-change-in-prod-32chars

# Backend API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# PostgreSQL + PostGIS Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=forest_fire_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# For local host outside Docker: postgresql://postgres:postgres@localhost:5432/forest_fire_db
# For Docker network: postgresql://postgres:postgres@postgres:5432/forest_fire_db
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/forest_fire_db

# Redis & Celery Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Spatial Grid & Domain Defaults
DEFAULT_GRID_RESOLUTION_METERS=500
DEFAULT_CRS=EPSG:4326

# Frontend (Vite) Environment Variables
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Optional Mapbox token. If left blank, open-source Leaflet / OpenStreetMap tiles are used.
VITE_MAPBOX_ACCESS_TOKEN=
VITE_DEFAULT_MAP_CENTER_LAT=20.5937
VITE_DEFAULT_MAP_CENTER_LNG=78.9629
VITE_DEFAULT_MAP_ZOOM=5
